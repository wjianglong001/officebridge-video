[
 {
  "段": 1,
  "text": "Hello，",
  "start": 0.19,
  "end": 0.59
 },
 {
  "段": 1,
  "text": "大家好，",
  "start": 0.59,
  "end": 1.21
 },
 {
  "段": 1,
  "text": "我是王师兄，",
  "start": 1.21,
  "end": 2.48
 },
 {
  "段": 1,
  "text": "这是我的第一个视频。",
  "start": 2.64,
  "end": 4.33
 },
 {
  "段": 1,
  "text": "不知道你有没有过这样的困扰：",
  "start": 4.51,
  "end": 7.3
 },
 {
  "段": 1,
  "text": "让AI帮你处理表格，",
  "start": 7.42,
  "end": 8.36
 },
 {
  "段": 1,
  "text": "它总是理解不了你的需求。",
  "start": 8.66,
  "end": 10.55
 },
 {
  "段": 1,
  "text": "你得先把数据复制给它，",
  "start": 11.03,
  "end": 12.88
 },
 {
  "段": 1,
  "text": "再跟它解释要改哪几格；",
  "start": 13.34,
  "end": 15.33
 },
 {
  "段": 1,
  "text": "好不容易给出结果，",
  "start": 15.72,
  "end": 17.17
 },
 {
  "段": 1,
  "text": "还得自己一格一格贴回去，",
  "start": 17.17,
  "end": 18.6
 },
 {
  "段": 1,
  "text": "一不小心，",
  "start": 18.84,
  "end": 19.72
 },
 {
  "段": 1,
  "text": "连不该动的数据也改了。",
  "start": 20.09,
  "end": 21.69
 },
 {
  "段": 2,
  "text": "所以我做了一个开源项目，",
  "start": 22.67,
  "end": 24.61
 },
 {
  "段": 2,
  "text": "叫OfficeBridge，",
  "start": 24.95,
  "end": 26.08
 },
 {
  "段": 2,
  "text": "中文名办公桥。",
  "start": 26.6,
  "end": 27.85
 },
 {
  "段": 2,
  "text": "它直接装在WPS表格里，",
  "start": 28.21,
  "end": 30.53
 },
 {
  "段": 2,
  "text": "一头连着你的表格，",
  "start": 30.68,
  "end": 32.25
 },
 {
  "段": 2,
  "text": "一头连着你电脑上已经装好的AI工具。",
  "start": 32.43,
  "end": 35.78
 },
 {
  "段": 2,
  "text": "你选中哪里，",
  "start": 35.92,
  "end": 36.67
 },
 {
  "段": 2,
  "text": "AI就看到哪里；",
  "start": 36.93,
  "end": 38.05
 },
 {
  "段": 2,
  "text": "它先给你看修改方案，",
  "start": 38.39,
  "end": 40.4
 },
 {
  "段": 2,
  "text": "你点了\"应用\"，",
  "start": 40.55,
  "end": 41.64
 },
 {
  "段": 2,
  "text": "它才真的动手改。",
  "start": 41.89,
  "end": 43.06
 },
 {
  "段": 2,
  "text": "下面我用四个例子演示给你看。",
  "start": 43.42,
  "end": 46.07
 },
 {
  "段": 3,
  "text": "第一个能力：",
  "start": 47.03,
  "end": 48.55
 },
 {
  "段": 3,
  "text": "你选哪，",
  "start": 48.78,
  "end": 49.37
 },
 {
  "段": 3,
  "text": "它改哪。",
  "start": 49.84,
  "end": 50.57
 },
 {
  "段": 3,
  "text": "我框选这八格金额，",
  "start": 50.57,
  "end": 52.53
 },
 {
  "段": 3,
  "text": "跟它说，",
  "start": 52.67,
  "end": 53.39
 },
 {
  "段": 3,
  "text": "统一保留两位小数。",
  "start": 53.39,
  "end": 55.22
 },
 {
  "段": 3,
  "text": "你看，",
  "start": 55.39,
  "end": 55.86
 },
 {
  "段": 3,
  "text": "输入框自动带上了我选的范围。",
  "start": 55.86,
  "end": 58.23
 },
 {
  "段": 3,
  "text": "先看预览，",
  "start": 58.73,
  "end": 59.59
 },
 {
  "段": 3,
  "text": "确认范围没问题，",
  "start": 60.13,
  "end": 61.61
 },
 {
  "段": 3,
  "text": "再点应用。",
  "start": 61.9,
  "end": 62.71
 },
 {
  "段": 3,
  "text": "八格全变成两位小数，",
  "start": 63.1,
  "end": 64.87
 },
 {
  "段": 3,
  "text": "选区外面的数据，",
  "start": 65.31,
  "end": 66.57
 },
 {
  "段": 3,
  "text": "一个都没动。",
  "start": 66.81,
  "end": 67.51
 },
 {
  "段": 4,
  "text": "第二个能力，",
  "start": 68.53,
  "end": 69.35
 },
 {
  "段": 4,
  "text": "来个复杂点的。",
  "start": 69.66,
  "end": 70.6
 },
 {
  "段": 4,
  "text": "我直接说：",
  "start": 71.43,
  "end": 72.39
 },
 {
  "段": 4,
  "text": "把六到九月的应付费用按月汇总，",
  "start": 72.74,
  "end": 75.73
 },
 {
  "段": 4,
  "text": "放进一张新表，",
  "start": 76.01,
  "end": 77.57
 },
 {
  "段": 4,
  "text": "再画一张折线图。",
  "start": 77.98,
  "end": 79.51
 },
 {
  "段": 4,
  "text": "它会先去读数据，",
  "start": 79.95,
  "end": 81.3
 },
 {
  "段": 4,
  "text": "搞清楚哪列是月份、",
  "start": 81.49,
  "end": 83.21
 },
 {
  "段": 4,
  "text": "哪列是金额、",
  "start": 83.46,
  "end": 84.33
 },
 {
  "段": 4,
  "text": "按什么口径算。",
  "start": 84.47,
  "end": 85.52
 },
 {
  "段": 4,
  "text": "方案出来，",
  "start": 85.91,
  "end": 86.53
 },
 {
  "段": 4,
  "text": "我点第一次应用，",
  "start": 86.77,
  "end": 87.69
 },
 {
  "段": 4,
  "text": "新表建好了。",
  "start": 87.98,
  "end": 88.84
 },
 {
  "段": 4,
  "text": "注意看，",
  "start": 89.08,
  "end": 89.53
 },
 {
  "段": 4,
  "text": "我什么都没输入，",
  "start": 89.87,
  "end": 91.03
 },
 {
  "段": 4,
  "text": "它拿着刚才的结果，",
  "start": 91.17,
  "end": 92.35
 },
 {
  "段": 4,
  "text": "自己接着准备图表。",
  "start": 92.55,
  "end": 93.75
 },
 {
  "段": 4,
  "text": "第二次点应用，",
  "start": 94.2,
  "end": 95.11
 },
 {
  "段": 4,
  "text": "汇总表加折线图，",
  "start": 95.47,
  "end": 96.66
 },
 {
  "段": 4,
  "text": "齐活！",
  "start": 96.87,
  "end": 97.32
 },
 {
  "段": 5,
  "text": "第三个能力，",
  "start": 98.27,
  "end": 99.44
 },
 {
  "段": 5,
  "text": "几张表一起处理。",
  "start": 99.84,
  "end": 101.07
 },
 {
  "段": 5,
  "text": "费用明细在一张表，",
  "start": 101.53,
  "end": 103.43
 },
 {
  "段": 5,
  "text": "部门预算在另一张表，",
  "start": 103.59,
  "end": 105.53
 },
 {
  "段": 5,
  "text": "我想知道每个月、",
  "start": 105.68,
  "end": 107.06
 },
 {
  "段": 5,
  "text": "每个部门有没有超预算。",
  "start": 107.39,
  "end": 109.25
 },
 {
  "段": 5,
  "text": "它先读懂两张表的结构，",
  "start": 109.59,
  "end": 111.91
 },
 {
  "段": 5,
  "text": "再按月份和部门汇总费用、",
  "start": 112.15,
  "end": 115.01
 },
 {
  "段": 5,
  "text": "对上预算，",
  "start": 115.16,
  "end": 116.32
 },
 {
  "段": 5,
  "text": "还特意避免同一份预算被重复计算。",
  "start": 116.7,
  "end": 120.28
 },
 {
  "段": 5,
  "text": "核对一下方案，",
  "start": 120.42,
  "end": 121.54
 },
 {
  "段": 5,
  "text": "点应用。",
  "start": 121.96,
  "end": 122.63
 },
 {
  "段": 5,
  "text": "二十七组超预算记录，",
  "start": 122.8,
  "end": 124.94
 },
 {
  "段": 5,
  "text": "全列出来了！",
  "start": 125.11,
  "end": 126.23
 },
 {
  "段": 6,
  "text": "最后，",
  "start": 127.22,
  "end": 127.6
 },
 {
  "段": 6,
  "text": "它不挑AI。",
  "start": 127.83,
  "end": 128.76
 },
 {
  "段": 6,
  "text": "Codex、",
  "start": 129.06,
  "end": 129.62
 },
 {
  "段": 6,
  "text": "WorkBuddy、",
  "start": 129.8,
  "end": 130.35
 },
 {
  "段": 6,
  "text": "豆包，",
  "start": 130.57,
  "end": 130.95
 },
 {
  "段": 6,
  "text": "右上角切一下就能连上，",
  "start": 131.43,
  "end": 133.07
 },
 {
  "段": 6,
  "text": "用的都是你已经登录好的账号。",
  "start": 133.41,
  "end": 135.37
 },
 {
  "段": 7,
  "text": "总结一下：",
  "start": 136.35,
  "end": 137.01
 },
 {
  "段": 7,
  "text": "办公桥就在你的WPS表格里，",
  "start": 137.32,
  "end": 140.15
 },
 {
  "段": 7,
  "text": "选哪改哪，",
  "start": 140.31,
  "end": 141.34
 },
 {
  "段": 7,
  "text": "先预览再应用，",
  "start": 141.55,
  "end": 142.74
 },
 {
  "段": 7,
  "text": "还能接你自己的AI工具。",
  "start": 142.87,
  "end": 145.39
 },
 {
  "段": 7,
  "text": "项目本身开源免费，",
  "start": 145.51,
  "end": 147.19
 },
 {
  "段": 7,
  "text": "目前支持Windows版的WPS表格，",
  "start": 147.4,
  "end": 150.72
 },
 {
  "段": 7,
  "text": "Excel版也在计划中。",
  "start": 150.92,
  "end": 152.8
 },
 {
  "段": 7,
  "text": "我写了五年后端，",
  "start": 153.26,
  "end": 154.52
 },
 {
  "段": 7,
  "text": "现在专心做AI开发，",
  "start": 154.69,
  "end": 156.53
 },
 {
  "段": 7,
  "text": "以后会在这里分享我写的开源项目，",
  "start": 156.71,
  "end": 160.05
 },
 {
  "段": 7,
  "text": "也帮大家淘好用的开源宝贝。",
  "start": 160.19,
  "end": 162.46
 },
 {
  "段": 7,
  "text": "用的时候有问题，",
  "start": 162.73,
  "end": 164.31
 },
 {
  "段": 7,
  "text": "评论区找我。",
  "start": 164.31,
  "end": 165.3
 },
 {
  "段": 7,
  "text": "关注王师兄的AI营地，",
  "start": 165.8,
  "end": 167.6
 },
 {
  "段": 7,
  "text": "我们下期见。",
  "start": 167.86,
  "end": 168.82
 }
]